# Firebase Client Configuration (From Firebase Console > Project Settings > Web Apps)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Cloudinary Configuration (From Cloudinary Console > Dashboard & Settings > Upload)
# Note: Use an UNSIGNED upload preset. Never include Cloudinary API Secret in frontend.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=rani_matrimony_preset

# Admin UID (From Firebase Console > Authentication > Users > User UID)
# Used as secondary UI route guard; Firestore security rules provide backend enforcement.
VITE_ADMIN_UID=your_admin_user_uid_here
